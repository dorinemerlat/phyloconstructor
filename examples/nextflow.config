params {

    outdir = "${projectDir}/results_example"
    cachedir = "${projectDir}/cache_example"
    /*
     * Focal taxonomic group
     */
    group_taxid = '4948'

    group_species_csv = "${projectDir}/example/group_species.csv"
    outgroups         = "${projectDir}/example/outgroups.csv"

    /*
     * Search all public resources available for Torulaspora.
     */
    download_uniprot            = true
    download_ncbi_proteomes     = true
    download_ncbi_assemblies    = true
    download_tsa_transcriptomes = true
    download_sra_reads          = true

    /*
     * BUSCO lineage
     */
    busco_lineage = 'saccharomycetes_odb12'

    /*
     * BUSCO filtering strategy
     *
     *   1 = complete single-copy BUSCOs
     *   2 = all complete BUSCOs
     *   3 = both
     */
    busco_filtering_mode = 1

    /*
     * [BUSCO completeness, gene occupancy]
     */
    phylogeny_thresholds = [
        [60,80]
    ]
}

includeConfig "$projectDir/conf/modules.config"