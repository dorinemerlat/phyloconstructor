params {
    outdir  = "${projectDir}/results"
    cachedir = "${projectDir}/cache"

    group_taxid = null

    group_species_csv = "${projectDir}/examples/group_species.csv"
    outgroups         = "${projectDir}/examples/outgroups.csv"

    download_uniprot            = true
    download_ncbi_proteomes     = true
    download_ncbi_assemblies    = true
    download_tsa_transcriptomes = true
    download_sra_reads          = true

    busco_lineage      = null
    busco_dataset_size = null

    /*
     * Complete BUSCO filtering strategy.
     *
     *   1 = Keep complete single-copy BUSCO hits only.
     *   2 = Keep all complete BUSCO hits: single-copy and duplicated BUSCOs.
     *   3 = Test both filtering strategies independently.
     */
    busco_filtering_mode = 1

    /*
     * Threshold combinations used for phylogenetic analyses.
     *
     * Each entry contains:
     *
     * [minimum BUSCO completeness, minimum gene occupancy]
     */
    phylogeny_thresholds = [
        [60, 80]
    ]
}

// Load process-specific configuration.
includeConfig "$projectDir/conf/modules.config"
